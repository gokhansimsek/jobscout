# Copy to .env and fill in. Never commit .env.

# Microsoft Graph (Outlook.com mailbox) - from your Azure app registration
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# "consumers" = personal Microsoft accounts only (outlook.com, hotmail, windowslive)
MS_AUTHORITY=https://login.microsoftonline.com/consumers

# Lesson 2
ANTHROPIC_API_KEY=
# Only if the key was created at org level (error: "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=
